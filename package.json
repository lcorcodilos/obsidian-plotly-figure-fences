{
	"name": "plotly-figure-fences",
	"version": "0.1.0",
	"description": "Renders `plotly` fenced code blocks as themed, interactive Plotly charts in Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "vitest run"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^20.14.2",
		"@types/plotly.js": "^3.0.13",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.21.5",
		"obsidian": "^1.5.7-1",
		"tslib": "2.4.0",
		"typescript": "^5.4.5",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"js-yaml": "^4.1.0",
		"plotly.js-dist": "^4.1.0"
	}
}
